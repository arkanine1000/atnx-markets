# Supabase — project URL and anon key go to the browser; service role stays
# server-only and bypasses RLS for admin operations.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel AI Gateway — used server-side by the capture pipeline for the vision
# model and embeddings (lib/vlm.ts, lib/embed.ts). Never expose to the client.
# Not needed on Vercel itself, where OIDC authenticates the gateway.
AI_GATEWAY_API_KEY=
# Optional overrides for the gateway model ids used by lib/vlm.ts.
# VLM_MODEL_IMAGE=google/gemini-3.8-flash
# VLM_MODEL_TEXT=google/gemini-3.5-flash-lite
# EMBED_MODEL=cohere/embed-v4.0
# Link a new-market proposal to an existing market without asking the model
# when it is at least this similar (cosine on the text embedding, trigram
# on the normalised name).
# LINK_COSINE=0.88
# LINK_TRIGRAM=0.85
# Below the link thresholds but above these, one text-only model call
# decides whether the proposal is the same as the nearest market.
# CONFIRM_COSINE=0.6
# CONFIRM_TRIGRAM=0.35
# A submission the model rejects as not cultural content gets a second
# look (lib/corroborate.ts): the name it might go by is checked against
# Know Your Meme, Wikipedia, YouTube, TikTok (one actor run), Bluesky and
# Google Trends, and anything found is put to the model again as evidence.
# "off" disables it; each source gets SECOND_LOOK_TIMEOUT_MS (default 8000).
# ADMISSION_SECOND_LOOK=on
# SECOND_LOOK_TIMEOUT_MS=8000
# Markets one account may create in a rolling day through the review step.
# Admins and moderators are exempt; so is any account listed by email or
# user id (comma-separated), which is where the eval tester goes.
# MARKET_CREATE_DAILY_LIMIT=10
# MARKET_CREATE_LIMIT_EXEMPT=eval-tester@atnx.app

# YouTube Data API v3 key (Google Cloud console -> APIs & Services ->
# Credentials, with the YouTube Data API enabled). Server only. Used by
# lib/vi/youtube.ts: one search per market per day (search.list is
# limited to 100 calls/day), one videos.list per market per hour. Without
# it the source is skipped.
YOUTUBE_API_KEY=

# Google Cloud service account for BigQuery (GDELT news coverage), as the
# base64 of its JSON key: base64 -w0 key.json. Role: BigQuery Job User on
# the project; the project can stay a sandbox (no billing, 1 TiB of queries
# a month). Used by lib/vi/gdelt.ts: an hourly count over GDELT's public
# GKG table, ~0.1-0.25 GB a run plus a 14-day backfill (~3 GB) for markets
# short of history. Without it GDELT is unknown for every market.
GCP_SA_KEY_B64=

# twitterapi.io (X). Server only. Used by lib/vi/x.ts: one advanced search
# per market every three hours for one hour of posts (the hour ending two
# hours ago, so views have matured), up to three pages of 20 ($0.15 per 1k
# tweets, floor $0.00015 per request), plus lib/creators/x-account.ts for
# verified own accounts every six hours. Without it the source is skipped.
# X_DAILY_TWEET_BUDGET caps tweets fetched per UTC day across all markets
# and both reads (default 20000, about $3; production runs 10000); 0
# pauses the source.
TWITTERAPI_IO_KEY=
# X_DAILY_TWEET_BUDGET=20000

# Bluesky app password (Settings -> App Passwords). Post search needs a
# session. Without both the source is skipped.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# The captured posts themselves as a VI source (lib/vi/post.ts): a
# market's TikTok, Instagram and X posts are read for their own views,
# hourly through the market's first day and every three hours after.
# TikTok and Instagram go through Apify (APIFY_TOKEN; $0.0003 and $0.0027
# a post), X through twitterapi.io. POST_DAILY_READ_BUDGET caps post reads
# per UTC day across all markets (default 300); 0 pauses the source.
# POST_DAILY_READ_BUDGET=300
# Google Trends benchmark keyword every term is co-queried against so
# readings compare across markets. Default "sudoku".
# VI_TRENDS_BENCHMARK=sudoku

# Calibration overrides, a JSON object with any of the fields of
# DEFAULT_CALIBRATION in lib/vi/score.ts (pointsPerDecade, log10ZeroPoint,
# units.<source>.k / .q, ...), applied without a deploy.
# VI_CALIBRATION_JSON=

# YouTube title relevance filter (lib/vi/relevance.ts): 0 keeps every
# video a name search returns.
# YT_TITLE_FILTER=1

# Jev (TypeSafe AI, through the gateway): typed verdicts with a
# probability. Each flag is off | shadow | on; the code default is shadow
# (recorded, not acting). Production since 2026-09-29: JEV_TWEETS=on,
# JEV_TITLES=off (Gemini won the title comparison), JEV_GATE unset (shadow).
# JEV_GATE=shadow      # admission gate for generic names (lib/admission-jev.ts)
# JEV_TITLES=off       # YouTube title relevance (lib/vi/relevance-jev.ts)
# JEV_TWEETS=on        # per-post relevance on X (lib/vi/relevance-x-jev.ts)
# JEV_TWEET_KEEP_AT=0.4  # keep a post at this probability or above (adjudicated 2026-09-29)
# JEV_MODEL=typesafe-ai/jev
# JEV_TIMEOUT_MS=4000

# Apify (TikTok hashtag counts; also the captured TikTok and Instagram
# posts, lib/vi/post.ts, and the second look's TikTok check). Server only. Used by lib/vi/tiktok.ts:
# one actor run per hourly pass with every qualifying market's hashtag
# (funny_ground/tiktok-hashtag-stats, $0.0005 per hashtag plus compute;
# the Free plan allows 50 rows a run), each market sampled every three
# hours. Without it the source is skipped. TIKTOK_DAILY_HASHTAG_BUDGET
# caps hashtags queried per UTC day (default 400, about $0.20); 0 pauses.
APIFY_TOKEN=
# TIKTOK_DAILY_HASHTAG_BUDGET=400
# Cost of one hashtag result for spend estimates: 0.0025 on the Free plan
# (default), 0.0005 on Apify's paid tiers.
# APIFY_USD_PER_HASHTAG=0.0025
# TikTok keyword search (lib/vi/tiktok-search.ts, clockworks/tiktok-scraper):
# the week's posts naming the phrase, searched every two days per market
# (daily when hot), the set re-read every six hours through the post
# reader. TIKTOK_SEARCH_DAILY_BUDGET caps searches a UTC day (default 40,
# about $1.60 at 10 results), TIKTOK_SEARCH_DAILY_READS the re-reads
# (default 400, about $0.12), TIKTOK_SEARCH_RESULTS the results a search
# asks for (default 10). 0 pauses. APIFY_USD_PER_SEARCH_RESULT is the
# tier price plus the date filter for spend estimates: 0.004 on the
# Starter plan (default), 0.005 on the Free tier.
# TIKTOK_SEARCH_DAILY_BUDGET=40
# TIKTOK_SEARCH_DAILY_READS=400
# TIKTOK_SEARCH_RESULTS=10
# APIFY_USD_PER_SEARCH_RESULT=0.004

# Vercel Cron — bearer token the scheduler sends to /api/markets/refresh.
CRON_SECRET=

# Extra origins allowed to call /api/captures and /api/portfolio with the
# session cookie, comma-separated. The app's own hosts are always allowed.
# Put the extension's origin here: chrome-extension://<extension id>
CORS_ALLOWED_ORIGINS=

# Eval script (scripts/eval-capture.mjs). A real user account on the target
# deployment; the script signs in and posts fixtures as that user.
EVAL_BASE_URL=http://localhost:3000
EVAL_USER_EMAIL=
EVAL_USER_PASSWORD=
