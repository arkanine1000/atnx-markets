# Supabase — project URL and anon key go to the browser; service role stays
# server-only and bypasses RLS for admin operations.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — used server-side by /api/captures to run Claude vision on
# uploaded screenshots. Never expose to the client.
ANTHROPIC_API_KEY=

# Vercel Cron — bearer token the scheduler sends to /api/markets/refresh.
CRON_SECRET=

# Chrome Web Store listing URL. Leave empty until the extension is published;
# the landing page shows "coming soon" instead of a link while it is unset.
NEXT_PUBLIC_EXTENSION_URL=
